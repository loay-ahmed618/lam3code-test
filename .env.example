# SOLDOC Environment Variables Example

# Server Environment
ENV=development
SECRET_KEY=soldoc_super_secure_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite; for PostgreSQL with PostGIS, configure:
# DATABASE_URL=postgresql://soldoc_user:password@localhost:5432/soldoc_db
DATABASE_URL=sqlite:///./soldoc.db

# NASA & Open Data APIs
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
# Optional Earthdata / GPM / Landsat token if integrating direct NASA CMR / Earthdata login
EARTHDATA_BEARER_TOKEN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
